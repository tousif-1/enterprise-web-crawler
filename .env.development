# Development Environment Configuration

# Build Configuration
BUILD_TARGET=dev
NODE_ENV=development
VOLUME_MODE=rw

# Service Commands
BACKEND_COMMAND=npm run dev
CRAWLER_COMMAND=npm run dev
FRONTEND_COMMAND=npm run dev

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200

# Database Configuration
POSTGRES_DB=webcrawler
POSTGRES_USER=webcrawler
POSTGRES_PASSWORD=webcrawler_password
DATABASE_URL=postgresql://webcrawler:webcrawler_password@postgres:5432/webcrawler

# Redis Configuration
REDIS_URL=redis://redis:6379

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=false
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_PING_TIMEOUT=3000
ELASTICSEARCH_MAX_RETRIES=3

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Security
JWT_SECRET=dev-jwt-secret-key-change-in-production

# Crawler Configuration
MAX_CONCURRENT_CRAWLS=5
DEFAULT_CRAWL_TIMEOUT=30000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Development specific
DEBUG=true
LOG_LEVEL=debug