{
  "name": "@enterprise-web-crawler/backend",
  "version": "1.0.0",
  "description": "Backend API service for enterprise web crawler",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "ts-node src/database/migrator.ts migrate",
    "db:migrate:status": "ts-node src/database/migrator.ts status",
    "db:migrate:rollback": "ts-node src/database/migrator.ts rollback",
    "db:seed": "ts-node src/database/seeder.ts seed",
    "db:seed:clear": "ts-node src/database/seeder.ts clear",
    "db:seed:reset": "ts-node src/database/seeder.ts reset",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.10.0",
    "@enterprise-web-crawler/shared": "^1.0.0",
    "bull": "^4.11.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.0",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.0",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "socket.io-client": "^4.7.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.0"
  }
}
