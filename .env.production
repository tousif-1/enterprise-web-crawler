# Production Environment Configuration

# Build Configuration
BUILD_TARGET=production
NODE_ENV=production
VOLUME_MODE=ro

# Service Commands (overridden in docker-compose.prod.yml)
BACKEND_COMMAND=node packages/backend/dist/index.js
CRAWLER_COMMAND=node packages/crawler/dist/index.js
FRONTEND_COMMAND=nginx -g daemon off;

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200

# Database Configuration (use environment variables in production)
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_URL=${DATABASE_URL}

# Redis Configuration
REDIS_URL=${REDIS_URL}

# Elasticsearch Configuration
ELASTICSEARCH_URL=${ELASTICSEARCH_URL}
ELASTICSEARCH_USERNAME=${ELASTICSEARCH_USERNAME}
ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_PING_TIMEOUT=3000
ELASTICSEARCH_MAX_RETRIES=5

# Frontend Configuration
VITE_API_URL=${VITE_API_URL}
VITE_WS_URL=${VITE_WS_URL}

# Security (MUST be set via environment variables)
JWT_SECRET=${JWT_SECRET}

# Crawler Configuration
MAX_CONCURRENT_CRAWLS=20
DEFAULT_CRAWL_TIMEOUT=60000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Production specific
DEBUG=false
LOG_LEVEL=info