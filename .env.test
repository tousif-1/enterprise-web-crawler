# Test Environment Configuration

# Build Configuration
BUILD_TARGET=dev
NODE_ENV=test
VOLUME_MODE=rw

# Service Commands
BACKEND_COMMAND=npm run test -- --run
CRAWLER_COMMAND=npm run test -- --run
FRONTEND_COMMAND=npm run test -- --run

# Port Configuration
BACKEND_PORT=8001
FRONTEND_PORT=3001
POSTGRES_PORT=5433
REDIS_PORT=6380
ELASTICSEARCH_PORT=9201

# Database Configuration
POSTGRES_DB=webcrawler_test
POSTGRES_USER=webcrawler
POSTGRES_PASSWORD=webcrawler_password
DATABASE_URL=postgresql://webcrawler:webcrawler_password@postgres-test:5432/webcrawler_test

# Redis Configuration
REDIS_URL=redis://redis-test:6379

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch-test:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=false
ELASTICSEARCH_REQUEST_TIMEOUT=10000
ELASTICSEARCH_PING_TIMEOUT=3000
ELASTICSEARCH_MAX_RETRIES=3

# Frontend Configuration
VITE_API_URL=http://backend:8000
VITE_WS_URL=ws://backend:8000

# Security
JWT_SECRET=test-jwt-secret

# Crawler Configuration
MAX_CONCURRENT_CRAWLS=2
DEFAULT_CRAWL_TIMEOUT=10000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Test specific
DEBUG=true
LOG_LEVEL=debug
TEST_TIMEOUT=30000